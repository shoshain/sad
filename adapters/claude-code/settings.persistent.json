{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment": "Persistent variant — adds SessionStart hook that loads SAD context every session. Generated by sad-init --persistent. Merge keys with your existing .claude/settings.json; do not overwrite.",
  "permissions": {
    "allow": [
      "Bash(.sad/scripts/*)",
      "PowerShell(.sad/scripts/*)",
      "Read(./.sad/**)",
      "Read(./specs/**)",
      "Read(./commands/**)",
      "Read(./agents/**)",
      "Read(./hooks/**)",
      "Read(./LIFECYCLE.md)",
      "Read(./MANIFESTO.md)",
      "Read(./MATURITY.md)",
      "Read(./ROLES.md)",
      "Read(./NOVEL.md)",
      "Read(./CHEATSHEET.md)",
      "Read(./QUICKSTART.md)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "command": "cat AGENTS.md .sad/rules/core/README.md .sad/state/sad-state.md 2>/dev/null; echo '---'; head -n 80 .sad/memory/constitution.md 2>/dev/null; echo '---'; bash .sad/scripts/next-step.sh 2>/dev/null || true"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "filePatterns": ["**/feature.spec.md"],
        "command": "cat .sad/memory/constitution.md .sad/stakeholders/non-technical.md .sad/rules/core/README.md 2>/dev/null"
      },
      {
        "matcher": "Write|Edit",
        "filePatterns": ["**/tasks.md"],
        "command": ".sad/scripts/check-tier-approvals.sh \"$(dirname \"$CLAUDE_TOOL_INPUT_file_path\")\" || exit 2"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "filePatterns": ["**/reconciliation.md"],
        "command": "echo 'SAD: post-reconcile — nudge semi-technical reviewer.'"
      }
    ]
  }
}
